<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ data extraction rules: nothing in the app sandbox is eligible
     for device-to-device migration (see backup_rules.xml for the same policy).
     The worklet's dirs are session/device-scoped and must not be restored.
     Excludes every sandboxed domain in both cloud backup and device transfer
     (`allowBackup="false"` makes this defense-in-depth). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
