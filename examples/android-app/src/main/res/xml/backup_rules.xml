<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up (Android 11 and lower; see data_extraction_rules.xml
     for 12+). Every domain is excluded, including `root` (app_webview: WebView
     cookies, Local Storage, IndexedDB) and the device-protected `device_*`
     domains. The worklet's storage lives in no_backup/ and its caches in
     cache/, which the platform never backs up. `allowBackup="false"` already
     disables backup there; these rules are defense-in-depth. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
