{
  "name": "@less/bare",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "The boring bootstrap for cross-platform apps on the Bare runtime: wire protocol, plugin kernel, RPC messenger, transports, and native host bridges.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersCan/less-bare-android.git"
  },
  "workspaces": [
    "examples/*",
    "e2e"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./core": "./dist/index.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./plugins": "./dist/plugins.mjs",
    "./plugins/health/events": "./dist/plugins-health-events.mjs",
    "./plugins/discovery/events": "./dist/plugins-discovery-events.mjs",
    "./plugins/permissions/events": "./dist/plugins-permissions-events.mjs",
    "./plugins/media/events": "./dist/plugins-media-events.mjs",
    "./transports": "./dist/transports.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "vp check",
    "lint": "vp fmt . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vp test && npm run test:e2e:web && npm run test:e2e:harness",
    "test:unit": "vp test",
    "test:e2e:web": "node scripts/playwright-local-browsers.mjs test",
    "dev": "concurrently \"vp -C examples/web dev\" \"npm run dev:bare\"",
    "predev": "npm run build:pkg",
    "dev:bare": "node scripts/dev-bare.mjs",
    "dev:mock": "VITE_TRANSPORT_MODE=mock vp -C examples/web dev",
    "predev:mock": "npm run build:pkg",
    "dev:ws": "vp -C examples/web dev",
    "predev:ws": "npm run build:pkg",
    "dev:e2e": "vp -C examples/web dev --host 127.0.0.1 --port 4173 --strictPort",
    "predev:e2e": "npm run build:pkg",
    "build": "npm run build:android-assets",
    "build:pkg": "vp pack",
    "prepack": "npm run build:pkg",
    "prepublishOnly": "npm run build:pkg",
    "build:web": "npm run build:pkg && vp -C examples/web build",
    "build:core": "npm run build:bare:app",
    "build:android-assets": "npm run build:core && npm run build:web",
    "build:ios": "node scripts/build-ios-app.mjs",
    "test:ios": "node scripts/test-ios.mjs",
    "build:bare": "npm run build:core",
    "build:bare:app": "esbuild core/main.core.ts --bundle --packages=external --platform=node --format=esm --outfile=core/main.core.gen.js",
    "build:harness": "esbuild core/harness.core.ts --bundle --packages=external --platform=node --format=esm --outfile=core/harness.core.gen.js",
    "harness:e2e": "npm run build:harness && npm run build:web && node scripts/harness-e2e.mjs",
    "test:e2e:harness": "node scripts/playwright-local-browsers.mjs test --config playwright.harness.config.ts",
    "playwright:install": "node scripts/playwright-local-browsers.mjs install chromium",
    "smoke:loopback": "esbuild scripts/smoke-loopback.mjs --bundle --packages=external --platform=node --format=esm --outfile=scripts/smoke-loopback.gen.mjs && bare scripts/smoke-loopback.gen.mjs",
    "smoke:p2p": "npm run build:p2p-verify && rm -rf .p2p-smoke && mkdir .p2p-smoke && bare core/p2p-verify.core.gen.js .p2p-smoke",
    "build:p2p-verify": "esbuild core/p2p-verify.core.ts --bundle --packages=external --platform=node --format=esm --outfile=core/p2p-verify.core.gen.js",
    "prebuilds": "node scripts/fetch-prebuilds.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bare": "^1.28.0",
    "bare-link": "^3.3.0",
    "bare-pack": "^2.2.1",
    "bare-runtime": "^1.28.0",
    "concurrently": "^10.0.4",
    "corestore": "^7.12.0",
    "esbuild": "^0.28.0",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  },
  "dependencies": {
    "@mantaq/core": "^0.1.0",
    "@mantaq/sugar": "^0.1.0",
    "bare-crypto": "^1.15.3",
    "bare-encoding": "^1.0.3",
    "bare-env": "^3.0.0",
    "bare-fs": "^4.8.0",
    "bare-http1": "^4.5.7",
    "bare-path": "^3.1.1",
    "bare-tcp": "^2.2.7",
    "bare-ws": "^3.0.0",
    "fs-native-extensions": "1.5.0",
    "quickbit-native": "2.4.8",
    "rabin-native": "2.0.0",
    "rocksdb-native": "3.17.4",
    "simdle-native": "1.3.9",
    "sodium-native": "5.1.0",
    "udx-native": "1.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  }
}
