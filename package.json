{
  "name": "@less/bare",
  "version": "0.0.1",
  "type": "module",
  "description": "The boring bootstrap for cross-platform apps on the Bare runtime: wire protocol, plugin kernel, RPC messenger, transports, and native host bridges.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersCan/less-bare-android.git"
  },
  "workspaces": [
    "examples/*",
    "e2e"
  ],
  "exports": {
    ".": "./core/messages/index.ts",
    "./core": "./core/messages/index.ts",
    "./runtime": "./core/runtime.ts",
    "./plugins": "./plugins/index.ts",
    "./plugins/health/events": "./plugins/health/events.ts",
    "./plugins/discovery/events": "./plugins/discovery/events.ts",
    "./plugins/permissions/events": "./plugins/permissions/events.ts",
    "./plugins/media/events": "./plugins/media/events.ts",
    "./transports": "./web/transports/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "core/messages",
    "core/lib",
    "core/server",
    "core/runtime.ts",
    "core/main.core.ts",
    "plugins",
    "web/transports",
    "web/websocket-client.ts",
    "!**/*.test.ts",
    "README.md",
    "LICENSE",
    "vision.md"
  ],
  "scripts": {
    "check": "vp check",
    "lint": "vp fmt . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vp test && npm run test:e2e:web",
    "test:unit": "vp test",
    "test:e2e:web": "node scripts/playwright-local-browsers.mjs test",
    "dev": "concurrently \"vp -C examples/web dev\" \"npm run dev:bare\"",
    "dev:bare": "node scripts/dev-bare.mjs",
    "dev:mock": "VITE_TRANSPORT_MODE=mock vp -C examples/web dev",
    "dev:ws": "vp -C examples/web dev",
    "dev:e2e": "vp -C examples/web dev --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run build:android-assets",
    "build:web": "vp -C examples/web build",
    "build:core": "npm run build:bare:app",
    "build:android-assets": "npm run build:core && npm run build:web",
    "build:ios": "node scripts/build-ios-app.mjs",
    "test:ios": "node scripts/test-ios.mjs",
    "build:bare": "npm run build:core",
    "build:bare:app": "esbuild core/main.core.ts --bundle --packages=external --platform=node --format=esm --outfile=core/main.core.gen.js",
    "build:harness": "esbuild core/harness.core.ts --bundle --packages=external --platform=node --format=esm --outfile=core/harness.core.gen.js",
    "playwright:install": "node scripts/playwright-local-browsers.mjs install chromium",
    "smoke:loopback": "esbuild scripts/smoke-loopback.mjs --bundle --packages=external --platform=node --format=esm --outfile=scripts/smoke-loopback.gen.mjs && bare scripts/smoke-loopback.gen.mjs",
    "prebuilds": "node scripts/fetch-prebuilds.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bare": "^1.28.0",
    "bare-link": "^3.3.0",
    "bare-pack": "^2.2.1",
    "bare-runtime": "^1.28.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  },
  "dependencies": {
    "bare-crypto": "^1.15.3",
    "bare-encoding": "^1.0.3",
    "bare-env": "^3.0.0",
    "bare-fs": "^4.8.0",
    "bare-http1": "^4.5.7",
    "bare-path": "^3.1.1",
    "bare-tcp": "^2.2.7",
    "bare-ws": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  }
}
