{
  "private": true,
  "name": "bare-android",
  "version": "1.0.0",
  "type": "module",
  "description": "Example of embedding Bare in an Android application",
  "scripts": {
    "lint": "prettier . --fix",
    "dev": "concurrently \"vite\" \"npm run dev:bare\"",
    "dev:bare": "node scripts/dev-bare.mjs",
    "dev:mock": "VITE_TRANSPORT_MODE=mock vite",
    "dev:ws": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run build:android-assets",
    "build:web": "vite build",
    "build:core": "npm run build:bare:app",
    "build:android-assets": "npm run build:core && npm run build:web",
    "build:bare": "npm run build:core",
    "build:bare:app": "esbuild core/main.core.ts --bundle --packages=external --platform=node --format=esm --outfile=core/main.core.gen.js",
    "playwright:install": "node scripts/playwright-local-browsers.mjs install chromium",
    "test:e2e:web": "node scripts/playwright-local-browsers.mjs test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "bare": "^1.28.0",
    "bare-link": "^1.2.0",
    "bare-pack": "^1.3.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@nanostores/router": "^1.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "bare-encoding": "^1.0.3",
    "bare-env": "^3.0.0",
    "bare-tcp": "^2.2.7",
    "bare-ws": "^2.1.0",
    "lit-html": "^3.3.2",
    "nanostores": "^1.2.0",
    "tailwindcss": "^4.2.2"
  }
}
